# Add these variables to the EXISTING Portainer stack variables.
# Preserve APP_PASSWORD and the configured DocuSign identifiers.
# Enter SMB credentials directly in Portainer; do not commit a completed file.
SMB_USERNAME=
SMB_PASSWORD=
# Set the Windows/AD domain, or the SMB server's workgroup for a local user.
SMB_DOMAIN=WORKGROUP
APP_PORT=8098

# Use a share account with read/write access to //10.1.10.4/docusign.
# A comma in a password cannot be used with this comma-delimited driver option.
# In that case, use a host-mounted share with a protected credentials file.
