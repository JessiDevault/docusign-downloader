# Copy this file to .env, replace the placeholders, then load it into
# Portainer: Stacks > Add stack > Environment variables > Load from .env file.
# Keep the completed .env file private. Never commit passwords or keys.

# Persistent folders on the Linux Docker host.
HOST_DATA_ROOT=/srv/docker/docusign-downloader
PUID=10001
PGID=10001

# Set the Docker host interface address for intranet access.
# Use 127.0.0.1 instead when accessing the app through a local reverse proxy.
BIND_ADDRESS=127.0.0.1
APP_PORT=8088
APP_USERNAME=admin
# REQUIRED: replace with a unique password of at least 16 characters.
APP_PASSWORD=

# Image version is pinned in portainer-stack.yml; no IMAGE_TAG is required.

# Demo: account-d.docusign.com. Production: account.docusign.com.
DOCUSIGN_AUTH_HOST=account-d.docusign.com
# Fill these in before running a DocuSign job.
DOCUSIGN_CLIENT_ID=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
# The RSA private key goes in the host config/private-key.pem file,
# not in this environment file.

# Enable only after a successful manual test.
AUTO_ENABLED=false
# Interval in seconds: 86400 = once per day; minimum 300.
AUTO_INTERVAL_SECONDS=86400
# When enabling automatic jobs, set the first date to scan: YYYY-MM-DD.
AUTO_START_DATE=
# Optional document-name regular expression; leave blank initially.
DOCUMENT_NAME_PATTERN=

# The public container image does not require registry credentials.


# Optional sender user GUID for automatic jobs; blank includes all accessible senders.
SENDER_USER_ID=
# Comma-separated template UUIDs; blank includes envelopes with or without templates.
TEMPLATE_IDS=
