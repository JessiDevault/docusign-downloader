HOST_DATA_ROOT=/srv/docker/docusign-downloader
PUID=10001
PGID=10001
# Use the Docker host's private interface address for LAN access, or loopback behind an HTTPS proxy.
BIND_ADDRESS=127.0.0.1
APP_PORT=8088
APP_USERNAME=admin
APP_PASSWORD=
IMAGE_TAG=main
# Demo by default. Production uses account.docusign.com.
DOCUSIGN_AUTH_HOST=account-d.docusign.com
DOCUSIGN_CLIENT_ID=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
AUTO_ENABLED=false
AUTO_INTERVAL_SECONDS=86400
AUTO_START_DATE=
DOCUMENT_NAME_PATTERN=

# Optional sender user GUID for automatic jobs; blank includes all accessible senders.
SENDER_USER_ID=
# Comma-separated template UUIDs; blank includes envelopes with or without templates.
TEMPLATE_IDS=
